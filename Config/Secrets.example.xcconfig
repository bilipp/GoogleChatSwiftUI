// Copy this file to Secrets.xcconfig and fill in your own values.
//
//     cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// Secrets.xcconfig is gitignored. Anything you leave out here keeps the
// placeholder default from Base.xcconfig.
//
// Despite the name, none of this is a secret: installed-app OAuth clients are
// issued without a client secret precisely because the binary is distributable.
// The file is ignored so the repository stays free of one person's project, not
// because publishing these values would be a leak. See docs/SETUP.md.

APP_BUNDLE_ID = com.example.GoogleChatSwiftUI
DEVELOPMENT_TEAM =

GOOGLE_OAUTH_CLIENT_ID = YOUR_NUMBER-YOUR_SUFFIX.apps.googleusercontent.com
GOOGLE_OAUTH_REDIRECT_SCHEME = com.googleusercontent.apps.YOUR_NUMBER-YOUR_SUFFIX
GCP_PROJECT_ID = YOUR_PROJECT_ID
